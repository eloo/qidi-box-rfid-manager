{
  "name": "qidi-rfid",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:build": "eas build --platform android --profile development",
    "android:release": "eas build --platform android --profile production",
    "android:build-local": "expo prebuild --clean && cd android && ./gradlew assembleRelease && cd ..",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.3.18",
    "expo": "~57.0.20",
    "expo-build-properties": "^57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-paper": "^5.15.3",
    "react-native-picker-select": "^9.3.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "reconnect.js": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^10.10.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver": true
  }
}
